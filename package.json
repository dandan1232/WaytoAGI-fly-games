{
  "name": "waytoagi-fly-games",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "homepage": "https://waytoagi-fly-games.vercel.app",
  "repository": { "type": "git", "url": "git+https://github.com/dandan1232/WaytoAGI-fly-games.git" },
  "type": "module",
  "description": "A recoil-powered rooftop cleaning adventure inspired by the Kärcher brief.",
  "engines": { "node": ">=22.14.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "test:ui": "playwright test interface.spec.ts",
    "test:production": "npm run build && node scripts/verify-production.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  }
}
